def _print_usage():
    """The overview from the command registry, colorized on a tty - shared
    with ctl.py via simlib.print_usage."""
    simlib.print_usage(sim_commands.overview())


def _usage_exit(c, hint=""):
    """usage error -> the command registry's first usage line plus the
    ./sim <cmd> help pointer (SL-0124); extra hints keep riding along."""
    simlib.usage_error_exit(sim_commands.COMMANDS[c]["usage"][0] +
                            f" - ./sim {c} help" + hint)


def _bad_flags(a, known):
    """--flags in `a` that are not in `known` (the auth overrides were
    already stripped). Typos like --view should fail, not be ignored."""
    return [x for x in a if x.startswith("-") and x not in known]


def _one_liner(path):
    """First line of a yaml's header comment, '#' stripped - the
    one-line 'what it proves' the library convention requires."""
    try:
        with open(path, errors="replace") as fh:
            for line in fh:
                line = line.strip()
                if not line:
                    continue
                return line.lstrip("#").strip() if line.startswith("#") \
                    else ""
    except OSError:
        pass
    return ""


def _sim_one_liner(path):
    """First line of a sim's `description:` key when present, else the
    header-comment one-liner (`_one_liner`). `./sim list sims` shows this
    so each fleet explains itself; sims without a description fall back
    to the 'what it proves' comment line."""
    try:
        spec = simlib.load_yaml(path) or {}
    except Exception:
        spec = {}
    desc = spec.get("description")
    if desc and desc.strip():
        first = desc.strip().splitlines()[0].strip()
        if first:
            return first
    return _one_liner(path)




def _validate_file(f):
    """`sim validate` checks for one yaml file. Prints findings; -> list
    of problem strings (empty = clean). Starts nothing."""
    import scenario as scenario_mod
    problems = []
    f = os.path.abspath(f)
    try:
        head = open(f, errors="replace").read(400)
    except OSError as e:
        return [str(e)]
    if not head.lstrip().startswith("#"):
        problems.append("no header comment (the first line must be a "
                        "# 'what it proves' paragraph - CI enforces it)")
    try:
        raw = simlib.load_yaml(f)
    except Exception as e:
        return problems + [f"yaml: {e}"]
    if not isinstance(raw, dict):
        return problems + ["top level is not a mapping"]
    base = os.path.dirname(f)

    def exists(key, val):
        if val and not os.path.isfile(os.path.join(base, val)):
            problems.append(f"{key}: {val} - file not found")

    try:
        if scenario_mod.is_sim_spec(raw):
            simlib.load_sim(f)
        elif scenario_mod.is_legacy_spec(raw):
            problems.append("`sim:`+`steps:` is the removed legacy format "
                            "(SL-0020) - rewrite as de.scenario/1")
        else:
            scn = scenario_mod.load_scenario(f, seed=1, probe_ports=False)
            exists("operation", raw.get("operation"))
            exists("world", raw.get("world"))
            cli = (raw.get("verify") or {}).get("cli")
            exists("verify.cli", cli)
            # scenario sim spec resolution: fleet cls -> blocks, ports
            simlib.load_sim(scn["sim"], base)
    except simlib.SimError as e:
        problems.append(str(e))
    except SystemExit as e:
        problems.append(f"loader exited {e.code}")
    return problems


def _module_overrides(a):
    """Pull every `--module <name>=<abs path>` out of argv (run/try):
    a catalog module or de_comm binary override for this run only.
    Validates before anything starts - unknown module or a path that is
    not an executable file is a usage error."""
    mods, rest, i = {}, [], 0
    while i < len(a):
        if a[i] == "--module":
            if i + 1 >= len(a) or "=" not in a[i + 1]:
                sys.exit("--module needs <name>=<abs path>")
            name, path = a[i + 1].split("=", 1)
            known = set(simlib.load_catalog()) | {"de_comm"}
            if name not in known:
                sys.exit(f"--module: unknown module {name!r} "
                         f"(catalog: {', '.join(sorted(known))})")
            if not (os.path.isfile(path) and os.access(path, os.X_OK)):
                sys.exit(f"--module {name}: {path} is not an "
                         "executable file")
            mods[name] = os.path.abspath(path)
            i += 2
        else:
            rest.append(a[i])
            i += 1
    return rest, mods


def _scaffold_sensor(name):
    """./sim new --sensor: blocks/<name>/ from _template_sensor - the
    block, its catalog fragment (which load_catalog merges - no
    modules/catalog.yaml edit), the sensor.yaml contract and the
    world-driven stub itself. @NAME@ is substituted in file contents
    and names."""
    src = os.path.join(simlib.SIM_ROOT, "blocks", "_template_sensor")
    dst = os.path.join(simlib.SIM_ROOT, "blocks", name)
    if os.path.exists(dst):
        sys.exit(f"{dst} already exists")
    shutil.copytree(src, dst)
    for f in os.listdir(dst):
        fpath = os.path.join(dst, f)
        txt = open(fpath).read().replace("@NAME@", name)
        os.remove(fpath)
        nf = os.path.join(dst, f.replace("@NAME@", name))
        open(nf, "w").write(txt)
        os.chmod(nf, 0o755 if nf.endswith(".py") else 0o644)
    print(f"wrote {os.path.relpath(dst, simlib.SIM_ROOT)}/ - a"
          " world-driven sensor block; the model lives in"
          f" stub_{name}.py, the contract in sensor.yaml")


def _cli_flags(argv):
    """Pull the global flags out of argv - they may appear anywhere on
    the command line. --user/--password/--auth-server are the sim's login
    overrides (show/up/run/view only); --shared keeps run/view/suite
    additive next to live sims (the SIM_SHARED=1 semantics) and
    --slot-base overrides the slot every port derives from. --set
    name=value (repeatable) overrides the sim yaml's `params:` block
    (SL-0116): type/choices are validated against the declarations in
    load_sim, and ${name} references are substituted before resolution."""
    rest, kw, sets, i = [], {}, {}, 0
    while i < len(argv):
        a = argv[i]
        if a in ("--user", "--password", "--auth-server", "--slot-base",
                 "--with"):
            if i + 1 >= len(argv):
                sys.exit(f"{a} needs a value")
            kw[a[2:].replace("-", "_")] = argv[i + 1]
            i += 2
        elif a == "--set":
            if i + 1 >= len(argv) or "=" not in argv[i + 1]:
                sys.exit("--set needs name=value")
            name, _, val = argv[i + 1].partition("=")
            sets[name] = val
            i += 2
        elif a == "--shared":
            kw["shared"] = True
            i += 1
        else:
            rest.append(a)
            i += 1
    if sets:
        kw["set"] = sets
    return rest, kw


def _version():
    """git describe --tags --always --dirty in the repo dir; 'unknown'
    outside a git checkout (no .version file or tags exist, so this is
    the short SHA of HEAD, -dirty when the tree is modified)."""
    root = os.path.dirname(os.path.abspath(__file__))
    try:
        desc = subprocess.run(
            ["git", "describe", "--tags", "--always", "--dirty"],
            cwd=root, capture_output=True, text=True, timeout=5)
        if desc.returncode == 0:
            return desc.stdout.strip()
    except (OSError, subprocess.SubprocessError):
        pass
    return "unknown"


def main(argv):
    if not argv or argv[0] in ("-h", "--help"):
        _print_usage()
        return 0
    if argv[0] == "help":
        # `./sim help` alone = top-level usage; `./sim help <command>` =
        # that command's help (SL-0115); `./sim help <sim>` = per-sim
        # description (SL-0120). The fuller `./sim up <sim> --help`
        # usage/params surface is SL-0117.
        if len(argv) == 1:
            _print_usage()
            return 0
        if argv[1] in sim_commands.COMMANDS:
            simlib.print_usage(sim_commands.command_help(argv[1]))
            return 0
        # `./sim help <sim-or-test>` -> the full per-sim help (SL-0121)
        simlib.print_usage(sim_help.render_help(simlib.resolve_sim_arg(
            argv[1], ("sims", "tests"))))
        return 0
    if argv[0] in ("-v", "--version", "version"):
        print(f"sim {_version()}")
        return 0
    c, a = argv[0], argv[1:]
    if "--force" in a:
        # SL-0053 - take over a sim another live session owns (downs it
        # on up/run/suite paths, stops it on `sim down`). Valid on every
        # command, so strip it before per-command flag parsing.
        a = [x for x in a if x != "--force"]
        os.environ["SIM_FORCE"] = "1"
    # `./sim <command> help|--help|-h` (help as the FIRST argument) ->
    # that command's help (SL-0115). When the first arg is a sim name,
    # per-sim help is SL-0117.
    if a and a[0] in ("help", "--help", "-h") and c in sim_commands.COMMANDS:
        simlib.print_usage(sim_commands.command_help(c))
        return 0
    try:
        if c in ("show", "up", "run", "try", "view", "suite",
                 "validate", "record", "studio"):
            a, flags = _cli_flags(a)
            # SL-0121: `./sim <verb> <sim> help|--help|-h` -> per-sim help,
            # exit 0 without starting anything. Bare `./sim <verb> help`
            # was already routed to command help above.
            if sim_help.wants_sim_help(c, a):
                pos = next(x for x in a if not x.startswith("-")
                           and x not in ("help", "--help", "-h"))
                kinds = ("sims", "tests") if c in ("run", "try") \
                    else ("sims",)
                simlib.print_usage(sim_help.render_help(
                    simlib.resolve_sim_arg(pos, kinds), c))
                return 0
            if flags.get("shared"):
                # launcher._shared() reads os.environ at call time; the
                # suite subprocess inherits it the same way
                os.environ["SIM_SHARED"] = "1"
            if flags.get("slot_base") is not None:
                sb = str(flags["slot_base"])
                if sb != "any":
                    try:
                        int(sb)
                    except ValueError:
                        sys.exit("--slot-base needs an integer or "
                                 f"'any', got {flags['slot_base']!r}")
                # a real override (tops the sim yaml's slot_base:) that
                # load_sim reads through setting() - env propagation
                # covers the suite's per-test subprocesses too
                os.environ["SIM_SLOT_BASE_OVERRIDE"] = sb
            if flags.get("with") is not None:
                # sims/overlays/<name>.yaml applied on top of the sim
                # (env propagates to the suite's per-test subprocesses)
                os.environ["SIM_WITH"] = str(flags["with"])
            if flags.get("set"):
                # SL-0116: --set name=value overrides for the sim yaml's
                # params: block. Installed in-process for this command
                # and mirrored to SIM_PARAMS so suite subprocesses
                # inherit them (same env channel --with/--slot-base use).
                simlib.set_param_overrides(flags["set"])
                os.environ["SIM_PARAMS"] = json.dumps(flags["set"])
            auth = {k: v for k, v in flags.items()
                    if k in ("user", "password", "auth_server")}
            if auth and c in ("suite", "validate"):
                sys.exit(f"{c} takes no login overrides")
            if auth:
                simlib.cli_auth(**auth)
        if c == "blocks":
            for name in simlib.list_blocks():
                b = simlib.load_block(name)
                fc = b["fc"]["vehicle"] if b["fc"] else "no fc"
                parent = f" (extends {b['chain'][-2]})" if len(b["chain"]) > 1 else ""
                print(simlib.col_green(f"{name:18s}")
                      + simlib.col_yellow(f" [{fc}]")
                      + f" {' + '.join(b['modules'])}"
                      + simlib.col_dim(parent))
                if b["description"]:
                    print(f"{'':18s} {b['description'].splitlines()[0]}")
        elif c == "block":
            b = simlib.load_block(a[0])
            simlib.validate_block(b, simlib.load_catalog())
            print(json.dumps(b, indent=2))
        elif c == "show":
            json_out = "--json" in a
            files = [x for x in a if not x.startswith("-")]
            bad = _bad_flags(a, sim_commands.allowed_flags("show"))
            if bad:
                simlib.usage_error_exit(f"unknown {' '.join(bad)} - ./sim show help")
            if len(files) != 1:
                _usage_exit("show")
            sim = simlib.load_sim(simlib.resolve_sim_arg(files[0]))
            if json_out:
                srv = sim["server"]
                out = {
                    "file": files[0], "name": sim["name"],
                    "server": {k: srv[k] for k in
                               ("type", "auth", "port", "control_port",
                                "auth_port", "auth_s2s_port", "ip",
                                "auth_ip", "gcs_party") if k in srv},
                    "slot_base": sim["slot_base"],
                    "speedup": sim["speedup"],
                    "units": [{"name": u["name"], "block": u["block"],
                               "fc": u["fc"], "modules": u["modules"],
                               "ports": u["ports"],
                               "account": (u.get("account") or {})
                               .get("user"),
                               "position": u["position"]}
                              for u in sim["units"]]}
                if sim["param_values"]:
                    out["params"] = sim["param_values"]
                print(json.dumps(out, indent=1))
                return
            srv = sim["server"]
            if sim["param_values"]:
                # SL-0116: the resolved params: values (defaults + --set)
                print("params: " + " ".join(
                    f"{k}={v}" for k, v in sim["param_values"].items()))
            print(f"server {srv['type']}{' +auth' if srv['auth'] else ''}: "
                  f"wss {srv['port']} control {srv['control_port']}"
                  + (f" auth {srv['auth_port']}" if srv["auth"] else "")
                  + (f" relay {srv['udp_relay']['port']}"
                     if srv.get("udp_relay") else "")
                  + f" slot {sim['slot_base']}")
            for u in sim["units"]:
                fc = u["fc"]
                print(f"  {u['name']:12s} block={u['block']:16s} "
                      + (f"{fc['vehicle']} sysid={fc['sysid']} pilot={fc['pilot_port']} "
                         f"fcb={fc['fcb_port']} "
                         + (f"fcbpx={fc['fcb_proxy']['port']}/"
                            f"{fc['fcb_proxy']['ctrl']} "
                            if fc.get("fcb_proxy") else "") if fc else "no-fc ")
                      + " ".join(f"{m}:{p}" for m, p in u["ports"].items())
                      + (f" acc={u['account']['user']}" if u.get("account") else "")
                      + f"  @{u['position']['lat']:.6f},{u['position']['lng']:.6f}")
        elif c == "up":
            import launcher
            files = [x for x in a if not x.startswith("-")]
            bad = _bad_flags(a, sim_commands.allowed_flags("up"))
            if bad:
                simlib.usage_error_exit(f"unknown {' '.join(bad)} - ./sim up help")
            if len(files) != 1:
                _usage_exit("up")
            import devstack
            if files[0] in devstack.stack_names():
                # a dev stack from stacks/*.yaml, not a sim - see
                # engine/devstack; --open-web only on stacks that
                # declare an open_url
                url = devstack.open_url(files[0])
                if "--open-web" in a and not url:
                    sys.exit(f"{files[0]} has no webclient link")
                devstack.up(files[0], fresh="--fresh" in a)
                if "--open-web" in a:
                    import ctl
                    ctl.xdg_open(url)
                return
            launcher.up(simlib.resolve_sim_arg(files[0]),
                        fresh="--fresh" in a,
                        open_web="--open-web" in a)
        elif c == "down":
            import launcher
            names = [x for x in a if not x.startswith("-")]
            bad = _bad_flags(a, sim_commands.allowed_flags("down"))
            if bad:
                simlib.usage_error_exit(f"unknown {' '.join(bad)} - ./sim down help")
            import devstack
            if names and names[0] in devstack.stack_names():
                return devstack.down(names[0])
            launcher.down(None if not names or "--all" in a else names[0])
        elif c == "sims":
            json_out = "--json" in a
            bad = _bad_flags(a, sim_commands.allowed_flags("sims"))
            if bad:
                simlib.usage_error_exit(f"unknown {' '.join(bad)} - ./sim sims help")
            names = simlib.sim_names()
            if json_out:
                print(json.dumps({"sims": [
                    {"name": n,
                     "units": len(simlib.load_manifest(n)["units"]),
                     "server_type":
                         simlib.load_manifest(n)["server"]["type"],
                     "procs_alive": len(simlib.read_pids(n))}
                    for n in names]}, indent=1))
            elif not names:
                print("no sim generated - ./sim up <sim.yaml>")
            else:
                for n in names:
                    m = simlib.load_manifest(n)
                    srv = m["server"]
                    print(f"{n:16s} {len(m['units'])} unit(s)  "
                          f"server {srv['type']}  "
                          f"{len(simlib.read_pids(n))} proc(s) alive")
        elif c == "servers":
            # the dev stack started by `./sim up de_servers`
            import devstack
            return devstack.main(a)
        elif c == "ports":
            # SL-0088: which of a sim's declared ports are actually bound
            # right now. `sim down` frees them all - this is the lease
            # visibility the udp_relay checks ask for.
            names = [x for x in a if not x.startswith("-")]
            bad = _bad_flags(a, sim_commands.allowed_flags("ports"))
            if bad:
                simlib.usage_error_exit(f"unknown {' '.join(bad)} - ./sim ports help")
            if len(names) > 1:
                _usage_exit("ports")
            scope = names or [n for n in simlib.sim_names()
                              if "--all" in a or simlib.read_pids(n)]
            if not scope:
                print("no live sim - ./sim up <sim.yaml> "
                      "or ./sim ports --all")
            for sn in scope:
                try:
                    m = simlib.load_manifest(sn)
                except Exception as e:
                    sys.exit(f"sim {sn!r}: {e}")
                alive = len(simlib.read_pids(sn))
                # collapse the relay's per-port udp rows into one range row
                rng = [r for r in simlib.port_rows(m)
                       if r[0] == f"{simlib.UDP_RELAY_LEASE}.range"]
                rows = [r for r in simlib.port_rows(m)
                        if r[0] != f"{simlib.UDP_RELAY_LEASE}.range"]
                n_bound = sum(simlib.port_bound(p, "udp")
                              for _, p, _ in rng)
                print(f"{sn} ({alive} proc(s) alive)")
                w = max(len(r[0]) for r in rows) if rows else 0
                for owner, port, proto in rows:
                    state = "bound" if simlib.port_bound(port, proto) \
                        else "free"
                    print(f"  {owner:{w}s}  {port:>6}  {proto:3s} {state}")
                if rng:
                    lo, hi = rng[0][1], rng[-1][1]
                    print(f"  {simlib.UDP_RELAY_LEASE + '.range':{w}s}  "
                          f"{lo}-{hi}  udp {n_bound}/{len(rng)} bound")
        elif c == "status":
            import ctl
            import devstack
            import launcher
            for s in devstack.stack_names():
                n = len(devstack.pids(s))
                if not n:
                    continue
                url = devstack.open_url(s)
                if url:
                    print(f"{s}: up - " + simlib.col_cyan(url)
                          + f" - ./sim logs {s}", flush=True)
                else:
                    print(f"{s}: {n}/{len(devstack.procs(s))}"
                          " procs up - ./sim servers", flush=True)
            # SL-0066 - surface orphaned scenario runners: a runner pid
            # alive while its fleet is down can still fire teardown
            # (op_abort/land) into whatever runs next; `sim down` reaps it
            for o in launcher.orphaned_runners():
                print(simlib.col_yellow(
                    f"orphaned scenario_runner pid {o['pid']} "
                    f"(sim {o['sim']!r}"
                    + (f", scenario {o['scenario']}" if o.get("scenario")
                       else "")
                    + f") - `./sim down {o['sim']}` reaps it"),
                    flush=True)
            # ctl parses `-s <sim>` only ahead of the command word -
            # hoist it so `./sim status -s X` works
            if len(a) >= 2 and a[0] in ("-s", "--sim"):
                ctl.main(a[:2] + ["status"] + a[2:])
            else:
                ctl.main(["status"] + a)
        elif c == "ctl":
            import ctl
            try:
                ctl.main(a)
            except KeyboardInterrupt:
                return 130
        elif c == "watch":
            # DE-0025: party watch on ANY reachable server stack - no sim
            # manifest needed (e.g. the external `./sim up de_servers`).
            # Flags go straight to engine/gcs_bridge.py watch mode.
            import gcs_bridge
            import asyncio
            try:
                asyncio.run(gcs_bridge.main(a))
            except KeyboardInterrupt:
                return 130
        elif c in ("run", "try"):
            import scenario_runner
            a, mods = _module_overrides(a)
            # SL-0071: None lets the file's `seed:` apply; --seed overrides
            seed = None
            if "--seed" in a:
                i = a.index("--seed")
                if i + 1 >= len(a):
                    sys.exit("--seed needs a value")
                seed = int(a[i + 1])
                del a[i:i + 2]
            record = None
            if "--record" in a:
                i = a.index("--record")
                if i + 1 >= len(a):
                    sys.exit("--record needs an output file")
                record = a[i + 1]
                del a[i:i + 2]
            files = [x for x in a if not x.startswith("-")]
            bad = _bad_flags(a, sim_commands.allowed_flags(c))
            if bad:
                simlib.usage_error_exit(f"unknown {' '.join(bad)} - ./sim {c} help")
            if len(files) != 1:
                _usage_exit(c)
            files[0] = simlib.resolve_sim_arg(files[0],
                                              ("sims", "tests"))
            # `try` is the iteration form of `run`: it always keeps the
            # sim (no teardown) so the next try lands on a warm fleet
            keep = "--keep" in a or c == "try"
            # the override is installed before the sim resolves so it
            # feeds the hash (same fleet + different bins = swap, not
            # a silent reuse)
            simlib.set_module_overrides(mods)
            # every test/scenario file is de.scenario/1 -> the P5-07 engine
            return scenario_runner.run(files[0], keep=keep,
                                       hold=bool({"--hold", "--view"}
                                                 & set(a)), seed=seed,
                                       record=record,
                                       open_web="--open-web" in a)
        elif c == "suite":
            # the full suite driver (verdicts, flaky rerun, junit) lives
            # in ci/run_suite.py - forward everything after `--seeds`
            seeds = "1,2,3"
            if "--seeds" in a:
                i = a.index("--seeds")
                if i + 1 >= len(a):
                    sys.exit("--seeds needs a value")
                seeds = a[i + 1]
                del a[i:i + 2]
            tier = None
            if "--tier" in a:
                i = a.index("--tier")
                if i + 1 >= len(a):
                    sys.exit("--tier needs a value")
                tier = a[i + 1]
                del a[i:i + 2]
            task = None
            if "--task" in a:
                i = a.index("--task")
                if i + 1 >= len(a):
                    sys.exit("--task needs a value")
                task = a[i + 1]
                del a[i:i + 2]
            keep = "--keep" in a
            dirs = [x for x in a if not x.startswith("-")] or ["tests"]
            bad = _bad_flags(a, sim_commands.allowed_flags("suite"))
            if bad:
                simlib.usage_error_exit(f"unknown {' '.join(bad)} - ./sim suite help")
            cmd = [sys.executable,
                   os.path.join(simlib.SIM_ROOT, "ci", "run_suite.py"),
                   "--roots"] + dirs + ["--seeds", seeds] \
                  + (["--keep"] if keep else []) \
                  + (["--tier", tier] if tier else []) \
                  + (["--task", task] if task else [])
            return subprocess.call(cmd, cwd=simlib.SIM_ROOT)
        elif c == "list":
            json_out = "--json" in a
            # SL-0137: --task/--kind/--tier filters (AND) combine with
            # the roots scopes; their values are pulled out here so a
            # value is never mistaken for a root name
            filt, rest = {}, []
            i = 0
            while i < len(a):
                if a[i] in ("--task", "--kind", "--tier"):
                    if i + 1 >= len(a):
                        sys.exit(f"{a[i]} needs a value")
                    filt[a[i][2:]] = a[i + 1]
                    i += 2
                else:
                    rest.append(a[i])
                    i += 1
            a = rest
            roots = [x for x in a if not x.startswith("-")]
            bad = _bad_flags(a, sim_commands.allowed_flags("list"))
            if bad:
                simlib.usage_error_exit(f"unknown {' '.join(bad)} - ./sim list help")
            if any(r not in ("scenarios", "tests", "sims", "stacks")
                   for r in roots):
                _usage_exit("list")
            # SL-0135: "stacks" is a scope of its own (the devstack
            # dev servers, not yaml files); a bare `list` still
            # defaults to scenarios+tests
            file_roots = [r for r in roots if r != "stacks"]
            if not roots:
                file_roots = ["scenarios", "tests"]

            def _list_files(root):
                # (path, kind, tasks) per yaml under the root, with the
                # SL-0137 filters applied; the spec is loaded only when
                # a filter or the --json rows need it
                d = os.path.join(simlib.SIM_ROOT, root)
                rows = []
                for f in sorted(glob.glob(
                        os.path.join(d, "**", "*.yaml"), recursive=True)):
                    kind = simlib.kind_of(f)
                    spec = {}
                    if filt or json_out:
                        spec = simlib.load_yaml(f) or {}
                    tasks = spec.get("tasks")
                    tasks = tasks if isinstance(tasks, list) else []
                    tier = spec.get("tier", "regression")
                    if filt.get("kind") and kind != filt["kind"]:
                        continue
                    if filt.get("tier") and tier != filt["tier"]:
                        continue
                    if filt.get("task") and filt["task"] not in tasks:
                        continue
                    rows.append((f, kind, tasks))
                return rows

            if json_out:
                out = {}
                if file_roots:
                    out["roots"] = [
                        {"root": root,
                         "files": [
                             {"file": os.path.relpath(f, simlib.SIM_ROOT),
                              "kind": kind, "tasks": tasks,
                              "description":
                                  (_sim_one_liner(f) if root == "sims"
                                   else _one_liner(f))[:80]}
                             for f, kind, tasks in _list_files(root)]}
                        for root in file_roots]
                if "stacks" in roots:
                    import devstack
                    out["stacks"] = {
                        name: [p["name"] for p in spec["procs"]]
                        for name, spec in devstack.STACKS.items()}
                print(json.dumps(out, indent=1))
            else:
                for root in file_roots:
                    rows = _list_files(root)
                    print(f"{root}/  ({len(rows)} files)")
                    for f, kind, tasks in rows:
                        rel = os.path.relpath(f, simlib.SIM_ROOT)
                        one = _sim_one_liner(f) if root == "sims" \
                            else _one_liner(f)
                        print(f"  {rel:52s} {one[:80]}")
                if "stacks" in roots:
                    import devstack
                    w = max(len(n) for n in devstack.STACKS)
                    print(f"stacks/  ({len(devstack.STACKS)} stacks)")
                    for name, spec in devstack.STACKS.items():
                        print(f"  {name:{w}s}  "
                              + " ".join(p["name"]
                                         for p in spec["procs"]))
        elif c == "new":
            sensor = "--sensor" in a
            names = [x for x in a if not x.startswith("-")]
            bad = _bad_flags(a, sim_commands.allowed_flags("new"))
            if bad:
                simlib.usage_error_exit(f"unknown {' '.join(bad)} - ./sim new help")
            ok_name = len(names) == 1 and \
                re.fullmatch(r"[\w-]+(/[\w-]+)*", names[0])
            if not ok_name:
                _usage_exit("new", " - word chars"
                            " (a/b nests under scenarios/; --sensor also"
                            " scaffolds blocks/<name>/ a world-driven"
                            " sensor stub)")
            if sensor and "/" in names[0]:
                sys.exit("--sensor names a new block dir - no '/'")
            dst = os.path.join(simlib.SIM_ROOT, "scenarios",
                               names[0] + ".yaml")
            if os.path.exists(dst):
                sys.exit(f"{dst} already exists")
            if sensor:
                _scaffold_sensor(names[0])
            tpl = open(os.path.join(simlib.SIM_ROOT, "templates",
                                    "scenario_sensor.yaml" if sensor
                                    else "scenario.yaml")).read()
            # @REL@ = repo-root prefix for the file's depth under
            # scenarios/ (scenarios/x.yaml -> ../, scenarios/a/b.yaml
            # -> ../../)
            depth = names[0].count("/") + 1
            tpl = tpl.replace("@NAME@",
                              os.path.basename(names[0])) \
                     .replace("@REL@", "../" * depth)
            os.makedirs(os.path.dirname(dst), exist_ok=True)
            open(dst, "w").write(tpl)
            rel = os.path.relpath(dst, simlib.SIM_ROOT)
            print(f"wrote {rel} - edit the header + fleet/timeline, then:")
            print(f"  ./sim validate {rel} && ./sim run {rel}")
        elif c == "validate":
            json_out = "--json" in a
            files = [x for x in a if not x.startswith("-")]
            bad = _bad_flags(a, sim_commands.allowed_flags("validate"))
            if bad:
                simlib.usage_error_exit(f"unknown {' '.join(bad)} - ./sim validate help")
            if len(files) != 1:
                _usage_exit("validate")
            files[0] = simlib.resolve_sim_arg(files[0],
                                              ("sims", "tests"))
            problems = _validate_file(files[0])
            if json_out:
                print(json.dumps({"file": files[0],
                                  "ok": not problems,
                                  "problems": problems}, indent=1))
                sys.exit(0 if not problems else 1)
            if problems:
                for p in problems:
                    print(simlib.col_red("not ok") + f"  {p}")
                sys.exit(f"{files[0]}: {len(problems)} problem(s)")
            print(simlib.col_green("ok") + f"  {files[0]}")
        elif c == "expand":
            import scenario as scenario_mod
            seed = None
            if "--seed" in a:
                i = a.index("--seed")
                if i + 1 >= len(a):
                    sys.exit("--seed needs a value")
                seed = int(a[i + 1])
                del a[i:i + 2]
            files = [x for x in a if not x.startswith("-")]
            bad = _bad_flags(a, sim_commands.allowed_flags("expand"))
            if bad:
                simlib.usage_error_exit(f"unknown {' '.join(bad)} - ./sim expand help")
            if len(files) != 1:
                _usage_exit("expand")
            scn = scenario_mod.load_scenario(files[0], seed=seed,
                                             probe_ports=False)
            if not scn.get("expanded"):
                if "--json" in a:
                    print(json.dumps({"file": files[0],
                                      "name": scn["name"],
                                      "seed": scn["seed"],
                                      "expanded": None,
                                      "error": "no chaos: block to "
                                               "expand"}, indent=1))
                    return 1
                sys.exit(f"{files[0]}: no chaos: block to expand")
            if "--json" in a:
                print(json.dumps(
                    {"file": files[0], "name": scn["name"],
                     "seed": scn["seed"],
                     "expanded": scenario_mod.expanded_spec(scn)},
                    indent=1))
            else:
                sys.stdout.write(scenario_mod.expanded_text(scn))
        elif c == "record":
            import record as record_mod
            # SL-0115: resolve a bare sim/test name to its file up front
            # (the target is the first positional that isn't the -o
            # value). A name that resolves to nothing stays as-is -
            # record._resolve prefers live-sim manifests anyway.
            skip, tgt = False, None
            for i, x in enumerate(a):
                if skip:
                    skip = False
                elif x == "-o":
                    skip = True
                elif not x.startswith("-"):
                    tgt = i
                    break
            if tgt is not None:
                try:
                    a[tgt] = simlib.resolve_sim_arg(a[tgt],
                                                    ("sims", "tests"))
                except simlib.SimError:
                    pass
            record_mod.main(a)
        elif c == "studio":
            import launcher
            world = record = None
            rest = []
            i = 0
            while i < len(a):
                if a[i] == "--world":
                    if i + 1 >= len(a):
                        sys.exit("--world needs a file or worlds/ name")
                    world = a[i + 1]
                    i += 2
                elif a[i] == "--record":
                    if i + 1 >= len(a):
                        sys.exit("--record needs an output file")
                    record = a[i + 1]
                    i += 2
                else:
                    rest.append(a[i])
                    i += 1
            files = [x for x in rest if not x.startswith("-")]
            bad = _bad_flags(rest, sim_commands.allowed_flags("studio"))
            if bad:
                simlib.usage_error_exit(f"unknown {' '.join(bad)} - ./sim studio help")
            if len(files) != 1:
                _usage_exit("studio")
            launcher.studio(simlib.resolve_sim_arg(files[0]),
                            world=world, record_out=record,
                            teardown="--down" in rest)
        elif c == "view":
            import scenario_runner
            record = None
            if "--record" in a:
                i = a.index("--record")
                if i + 1 >= len(a):
                    sys.exit("--record needs an output file")
                record = a[i + 1]
                del a[i:i + 2]
            files = [x for x in a if not x.startswith("-")]
            bad = _bad_flags(a, sim_commands.allowed_flags("view"))
            if bad:
                simlib.usage_error_exit(f"unknown {' '.join(bad)} - ./sim view help")
            if len(files) != 1:
                _usage_exit("view")
            files[0] = simlib.resolve_sim_arg(files[0],
                                              ("sims", "tests"))
            return scenario_runner.run(files[0], hold=True,
                                       record=record,
                                       open_web="--open-web" in a)
        elif c == "logs":
            sim_name = None
            if a and a[0] in ("-s", "--sim"):
                sim_name, a = a[1], a[2:]
            owner = a[0]
            import devstack
            if owner in devstack.stack_names():
                return devstack.logs(owner,
                                     a[1] if len(a) > 1 else None)
            if owner == "server":
                d = os.path.join(
                    simlib.server_dir(sim_name or simlib._single_sim()),
                    "logs")
            else:
                u = simlib.find_unit(owner, sim_name)
                if not u:
                    sys.exit(f"unknown unit {owner!r} (no generated sim "
                             "has it)")
                d = os.path.join(simlib.unit_dir(u), "logs")
            proc = a[1] if len(a) > 1 else None
            files = [os.path.join(d, f) for f in sorted(os.listdir(d))
                     if proc is None or f == proc + ".log"]
            subprocess.call(["tail", "-n", "40"] + files)
        elif c == "doctor":
            import doctor
            return doctor.main(a)
        elif c == "esp32":
            import esp32
            return esp32.main(a)
        elif c == "verbs":
            import registry
            bad = _bad_flags(a, sim_commands.allowed_flags("verbs"))
            if bad:
                simlib.usage_error_exit(f"unknown {' '.join(bad)} - ./sim verbs help")
            if "--json" in a:
                print(json.dumps({"verbs": [
                    {"name": v["name"], "kind": v["kind"],
                     "args": {"required": v["req"],
                              "optional": v["opt"]},
                     "doc": v["doc"], "example": v["eg"]}
                    for v in registry.VERBS]}, indent=1))
            else:
                w = max(len(v["name"]) for v in registry.VERBS)
                groups = (("step", "do: steps (act on the fleet)"),
                          ("probe", "do: probes (observe only)"),
                          ("fault", "fault: kinds"),
                          ("check", "assert: checks"))
                for kind, title in groups:
                    print(title)
                    for v in registry.by_kind(kind):
                        args = ", ".join(
                            [f"<{a}>" for a in v["req"]] +
                            [f"[{a}]" for a in v["opt"]])
                        print(f"  {v['name']:{w}}  {v['doc']}")
                        if args:
                            print(f"  {'':{w}}  args: {args}")
                        if v["eg"]:
                            print(f"  {'':{w}}  eg:   {v['eg']}")
                    print()
        elif c == "clean":
            import clean
            return clean.main(a)
        else:
            _print_usage()
            return 1
    except simlib.SimError as e:
        sys.exit(simlib.col_red("error:") + f" {e}")
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))

#!/usr/bin/env python3
"""DroneEngageStudio - sim: simulation and ground-truth testing from reusable
blocks. DroneEngage is the flagship integration (not the owner).

  ./sim blocks                     list blocks (reusable unit types)
  ./sim block <name>               show a block resolved through `extends`
  ./sim show <sim.yaml>            units, modules and ports a sim expands to
  ./sim up <sim.yaml> [--fresh] [--open-web]
                                   start a sim (restarts the same-named one;
                                   refuses ports of a live sim - sims run in
                                   parallel; unit names may repeat on
                                   per-sim servers but stay unique on a
                                   shared external stack or rendered
                                   cameras; --open-web xdg-opens the
                                   webclient link)
  ./sim down [name|--all]          stop one sim, or every sim
  ./sim sims                       generated sims and live process counts
  ./sim ports [name|--all]         live sims' declared ports vs what's bound
                                   right now (--all: every generated sim;
                                   udp_relay shows its whole udp range n/N)
  ./sim status [-s <sim>] [live|all] [--open-web]
                                   = ./sim ctl status (live sims only;
                                     `all` also lists downed ones;
                                     --open-web xdg-opens the sim's link)
  ./sim studio <sim.yaml> [--world <w>] [--record <file>] [--down]
                                   the human session in one command: the
                                   sim up (reuse if warm), the webclient
                                   planning mode opened in the browser,
                                   the de.worldstream/1 feed +
                                   Mavlink3DMap viewer when available
                                   (studio still runs without it), the
                                   session recorded through the record
                                   seam; Ctrl-C finalizes the recording
                                   and leaves the sim up unless --down
  ./sim ctl [-s <sim>] <cmd> ...   operator console (./sim ctl for help)
  ./sim run <file.yaml> [--seed N] [--keep] [--hold|--view] [--open-web]
                       [--module <name>=<path>] ...
                                   run a test/scenario - owns the machine:
                                   downs every other sim (the CI posture;
                                   --shared / SIM_SHARED=1 keeps it
                                   additive on a shared box). --keep skips
                                   the teardown, --hold parks after the
                                   timeline (world stream + Mavlink3DMap
                                   viewer live; the sim's webclient deep
                                   links print) until Ctrl-C. Interactive
                                   work is additive by default: a bare
                                   sims/*.yaml just comes up
                                   (hash-reused, like up). --open-web
                                   opens the webclient link once the sim
                                   is up (with --hold/--view or a bare
                                   sims file - a plain run tears it down
                                   again).
                                   --module <name>=<abs path> (repeatable)
                                   swaps a catalog module / de_comm binary
                                   for this run only: same fleet spec ->
                                   just that proc restarts on the warm sim
  ./sim try <file.yaml> [--module ...]   = run --keep: the build->try loop.
                                   Rebuilt de_mavlink? Point --module at the
                                   new bin and the scenario runs against it
                                   on the warm sim (no SITL warm-up)
  ./sim suite [dir ...] [--seeds 1,2,3] [--keep] [--tier smoke]
                                   run every yaml under dir(s) once per seed
                                   (default dir: tests) - the nightly run:
                                   owns the machine serially, unless
                                   --shared. verdicts + junit in
                                   var/results/nightly/; --tier smoke runs
                                   only the marked fast first-pass set
  ./sim view <scenario.yaml> [--open-web]
                                   one command for sim + Mavlink3DMap viewer:
                                   = run --hold (the scenario needs
                                   render: {mode: viewer}); same shared/
                                   exclusive rules as run
  ./sim record <sim|live-sim> -o <file.yaml>
                                   capture a live webclient session through
                                   the real server's command_plugin seam and
                                   write it as a de.scenario/1 scenario (+
                                   .md runbook stub); --record <file> on
                                   run/view records the window around a
                                   scenario run or its --hold
  ./sim list [scenarios|tests|sims]        catalog: files + one-line
                                   descriptions (default: scenarios+tests)
  ./sim new <name> [--sensor]     scaffold scenarios/<name>.yaml from
                                   templates/scenario.yaml; --sensor
                                   also writes blocks/<name>/ a
                                   world-driven sensor stub + contract
                                   (docs/SENSORS.md)
  ./sim validate <file.yaml>       schema + referenced-file check, starts
                                   nothing
  ./sim verbs [--json]            the de.scenario/1 verb registry: every
                                   do: step, do: probe, fault: kind and
                                   assert: check with its args, a
                                   one-line doc and an example
  ./sim doctor [sim.yaml] [--json] [--esp32]
                                   machine-readiness check: one
                                   OK/MISSING/OPTIONAL line per item with a
                                   fix line; a sim file scopes what is
                                   required to what that sim needs;
                                   --esp32 makes the ESP32 HIL rows
                                   required and probes the board
  ./sim esp32 <list|build|upload|check> [fw] [--port DEV] [--baud N]
              [--no-check]         the tools/hil/ ESP32 firmwares
                                   (default esp32_fake_fc, a fake
                                   ArduCopter for a phone's USB-OTG FCB
                                   link): upload = build + flash + run
                                   the firmware's check_*.py
  ./sim expand <file.yaml> [--seed N]
                                   print the chaos: schedule a run would
                                   execute (concrete fault steps inlined;
                                   same seed, same schedule), run nothing
  ./sim logs [-s <sim>] <unit|server> [proc]  tail a process log
  ./sim clean [--days N] [--all] [--dry-run]  prune var/run/ and var/results/
                                   (never a live sim; default keeps 7 days)
  ./sim -v | --version             print the sim repo version (git
                                   describe; short SHA + -dirty without
                                   tags)

Login overrides for show/up/run/view/studio (win over the sim yaml and
sim.local.env SIM_*_AUTH_*):
  --user <name> --password <code>    the one account every unit and the
                                     GCS bridge log in with (overrides
                                     per-unit account: too)
  --auth-server <host[:port]>        the authenticator (external server
                                     with auth: true only)

Global flags for show/up/run/view/suite/validate/studio:
  --shared                         run/view/suite stay additive next to
                                   live sims instead of downing them
                                   (= SIM_SHARED=1)
  --force                          take over a sim another live session
                                   still owns: up/run down it instead of
                                   refusing, `down` stops it (every
                                   command takes it; = SIM_FORCE=1)
  --slot-base <N|any>              the slot every port derives from (wins
                                   over the sim yaml's slot_base: and
                                   SIM_SLOT_BASE); `any` picks the lowest
                                   base whose ports no live sim or other
                                   process holds - a shifted pick changes
                                   the sim hash, so `run` does a fresh up
                                   instead of reusing (pin a number when
                                   iterating)
  --with <a[,b...]>                sims/overlays/<name>.yaml twists applied
                                   on top of the sim (server swap, extra
                                   units, config/fc pushes); each applied
                                   name appends to the sim name and the
                                   hash changes, so a variant never reuses
                                   another variant's warm sim

Layout: blocks/ (unit types) -> sims/ (fleets of blocks) -> tests/
(automated cases) and scenarios/ (human-run demos + examples).
docs/SCENARIOS.md is the authoring reference. See README.md.

Machine output: show, sims, status (and ./sim ctl status), list,
validate, expand, doctor and verbs take --json (docs/MACHINE_API.md).
A run's last line is `RESULT <dir>/summary.json` - the run's full
report.
"""

import glob
import json
import os
import re
import shutil
import signal
import subprocess
import sys

signal.signal(signal.SIGPIPE, signal.SIG_DFL)

# bytecode under var/pycache from the first import on (simlib sets it
# too, but only after itself is compiled - that left __pycache__ dirs)
sys.pycache_prefix = os.environ.setdefault(
    "PYTHONPYCACHEPREFIX",
    os.path.join(os.environ.get("SIM_VAR_DIR") or os.path.join(
        os.path.dirname(os.path.abspath(__file__)), "var"), "pycache"))

sys.path.insert(0, os.path.join(os.path.dirname(os.path.abspath(__file__)), "engine"))
import simlib


def _print_usage():
    """__doc__, colorized on a tty - shared with ctl.py via
    simlib.print_usage."""
    simlib.print_usage(__doc__)


def _bad_flags(a, known):
    """--flags in `a` that are not in `known` (the auth overrides were
    already stripped). Typos like --view should fail, not be ignored."""
    return [x for x in a if x.startswith("-") and x not in known]


def _one_liner(path):
    """First line of a yaml's header comment, '#' stripped - the
    one-line 'what it proves' the library convention requires."""
    try:
        with open(path, errors="replace") as fh:
            for line in fh:
                line = line.strip()
                if not line:
                    continue
                return line.lstrip("#").strip() if line.startswith("#") \
                    else ""
    except OSError:
        pass
    return ""


def _validate_file(f):
    """`sim validate` checks for one yaml file. Prints findings; -> list
    of problem strings (empty = clean). Starts nothing."""
    import scenario as scenario_mod
    problems = []
    f = os.path.abspath(f)
    try:
        head = open(f, errors="replace").read(400)
    except OSError as e:
        return [str(e)]
    if not head.lstrip().startswith("#"):
        problems.append("no header comment (the first line must be a "
                        "# 'what it proves' paragraph - CI enforces it)")
    try:
        raw = simlib.load_yaml(f)
    except Exception as e:
        return problems + [f"yaml: {e}"]
    if not isinstance(raw, dict):
        return problems + ["top level is not a mapping"]
    base = os.path.dirname(f)

    def exists(key, val):
        if val and not os.path.isfile(os.path.join(base, val)):
            problems.append(f"{key}: {val} - file not found")

    try:
        if scenario_mod.is_sim_spec(raw):
            simlib.load_sim(f)
        elif scenario_mod.is_legacy_spec(raw):
            problems.append("`sim:`+`steps:` is the removed legacy format "
                            "(SL-0020) - rewrite as de.scenario/1")
        else:
            scn = scenario_mod.load_scenario(f, seed=1, probe_ports=False)
            exists("operation", raw.get("operation"))
            exists("world", raw.get("world"))
            cli = (raw.get("verify") or {}).get("cli")
            exists("verify.cli", cli)
            # scenario sim spec resolution: fleet cls -> blocks, ports
            simlib.load_sim(scn["sim"], base)
    except simlib.SimError as e:
        problems.append(str(e))
    except SystemExit as e:
        problems.append(f"loader exited {e.code}")
    return problems


def _module_overrides(a):
    """Pull every `--module <name>=<abs path>` out of argv (run/try):
    a catalog module or de_comm binary override for this run only.
    Validates before anything starts - unknown module or a path that is
    not an executable file is a usage error."""
    mods, rest, i = {}, [], 0
    while i < len(a):
        if a[i] == "--module":
            if i + 1 >= len(a) or "=" not in a[i + 1]:
                sys.exit("--module needs <name>=<abs path>")
            name, path = a[i + 1].split("=", 1)
            known = set(simlib.load_catalog()) | {"de_comm"}
            if name not in known:
                sys.exit(f"--module: unknown module {name!r} "
                         f"(catalog: {', '.join(sorted(known))})")
            if not (os.path.isfile(path) and os.access(path, os.X_OK)):
                sys.exit(f"--module {name}: {path} is not an "
                         "executable file")
            mods[name] = os.path.abspath(path)
            i += 2
        else:
            rest.append(a[i])
            i += 1
    return rest, mods


def _scaffold_sensor(name):
    """./sim new --sensor: blocks/<name>/ from _template_sensor - the
    block, its catalog fragment (which load_catalog merges - no
    modules/catalog.yaml edit), the sensor.yaml contract and the
    world-driven stub itself. @NAME@ is substituted in file contents
    and names."""
    src = os.path.join(simlib.SIM_ROOT, "blocks", "_template_sensor")
    dst = os.path.join(simlib.SIM_ROOT, "blocks", name)
    if os.path.exists(dst):
        sys.exit(f"{dst} already exists")
    shutil.copytree(src, dst)
    for f in os.listdir(dst):
        fpath = os.path.join(dst, f)
        txt = open(fpath).read().replace("@NAME@", name)
        os.remove(fpath)
        nf = os.path.join(dst, f.replace("@NAME@", name))
        open(nf, "w").write(txt)
        os.chmod(nf, 0o755 if nf.endswith(".py") else 0o644)
    print(f"wrote {os.path.relpath(dst, simlib.SIM_ROOT)}/ - a"
          " world-driven sensor block; the model lives in"
          f" stub_{name}.py, the contract in sensor.yaml")


def _cli_flags(argv):
    """Pull the global flags out of argv - they may appear anywhere on
    the command line. --user/--password/--auth-server are the sim's login
    overrides (show/up/run/view only); --shared keeps run/view/suite
    additive next to live sims (the SIM_SHARED=1 semantics) and
    --slot-base overrides the slot every port derives from."""
    rest, kw, i = [], {}, 0
    while i < len(argv):
        a = argv[i]
        if a in ("--user", "--password", "--auth-server", "--slot-base",
                 "--with"):
            if i + 1 >= len(argv):
                sys.exit(f"{a} needs a value")
            kw[a[2:].replace("-", "_")] = argv[i + 1]
            i += 2
        elif a == "--shared":
            kw["shared"] = True
            i += 1
        else:
            rest.append(a)
            i += 1
    return rest, kw


def _version():
    """git describe --tags --always --dirty in the repo dir; 'unknown'
    outside a git checkout (no .version file or tags exist, so this is
    the short SHA of HEAD, -dirty when the tree is modified)."""
    root = os.path.dirname(os.path.abspath(__file__))
    try:
        desc = subprocess.run(
            ["git", "describe", "--tags", "--always", "--dirty"],
            cwd=root, capture_output=True, text=True, timeout=5)
        if desc.returncode == 0:
            return desc.stdout.strip()
    except (OSError, subprocess.SubprocessError):
        pass
    return "unknown"


def main(argv):
    if not argv or argv[0] in ("-h", "--help", "help"):
        _print_usage()
        return 0
    if argv[0] in ("-v", "--version", "version"):
        print(f"sim {_version()}")
        return 0
    c, a = argv[0], argv[1:]
    if "--force" in a:
        # SL-0053 - take over a sim another live session owns (downs it
        # on up/run/suite paths, stops it on `sim down`). Valid on every
        # command, so strip it before per-command flag parsing.
        a = [x for x in a if x != "--force"]
        os.environ["SIM_FORCE"] = "1"
    try:
        if c in ("show", "up", "run", "try", "view", "suite",
                 "validate", "record", "studio"):
            a, flags = _cli_flags(a)
            if flags.get("shared"):
                # launcher._shared() reads os.environ at call time; the
                # suite subprocess inherits it the same way
                os.environ["SIM_SHARED"] = "1"
            if flags.get("slot_base") is not None:
                sb = str(flags["slot_base"])
                if sb != "any":
                    try:
                        int(sb)
                    except ValueError:
                        sys.exit("--slot-base needs an integer or "
                                 f"'any', got {flags['slot_base']!r}")
                # a real override (tops the sim yaml's slot_base:) that
                # load_sim reads through setting() - env propagation
                # covers the suite's per-test subprocesses too
                os.environ["SIM_SLOT_BASE_OVERRIDE"] = sb
            if flags.get("with") is not None:
                # sims/overlays/<name>.yaml applied on top of the sim
                # (env propagates to the suite's per-test subprocesses)
                os.environ["SIM_WITH"] = str(flags["with"])
            auth = {k: v for k, v in flags.items()
                    if k in ("user", "password", "auth_server")}
            if auth and c in ("suite", "validate"):
                sys.exit(f"{c} takes no login overrides")
            if auth:
                simlib.cli_auth(**auth)
        if c == "blocks":
            for name in simlib.list_blocks():
                b = simlib.load_block(name)
                fc = b["fc"]["vehicle"] if b["fc"] else "no fc"
                parent = f" (extends {b['chain'][-2]})" if len(b["chain"]) > 1 else ""
                print(f"{name:18s} [{fc}] {' + '.join(b['modules'])}{parent}")
                if b["description"]:
                    print(f"{'':18s} {b['description'].splitlines()[0]}")
        elif c == "block":
            b = simlib.load_block(a[0])
            simlib.validate_block(b, simlib.load_catalog())
            print(json.dumps(b, indent=2))
        elif c == "show":
            json_out = "--json" in a
            files = [x for x in a if not x.startswith("-")]
            bad = _bad_flags(a, ("--json",))
            if bad or len(files) != 1:
                sys.exit("usage: ./sim show <sim.yaml> [--json]"
                         + (f" - unknown {' '.join(bad)}" if bad else ""))
            sim = simlib.load_sim(files[0])
            if json_out:
                srv = sim["server"]
                print(json.dumps({
                    "file": files[0], "name": sim["name"],
                    "server": {k: srv[k] for k in
                               ("type", "auth", "port", "control_port",
                                "auth_port", "auth_s2s_port", "ip",
                                "auth_ip", "gcs_party") if k in srv},
                    "slot_base": sim["slot_base"],
                    "speedup": sim["speedup"],
                    "units": [{"name": u["name"], "block": u["block"],
                               "fc": u["fc"], "modules": u["modules"],
                               "ports": u["ports"],
                               "account": (u.get("account") or {})
                               .get("user"),
                               "position": u["position"]}
                              for u in sim["units"]]}, indent=1))
                return
            srv = sim["server"]
            print(f"server {srv['type']}{' +auth' if srv['auth'] else ''}: "
                  f"wss {srv['port']} control {srv['control_port']}"
                  + (f" auth {srv['auth_port']}" if srv["auth"] else "")
                  + (f" relay {srv['udp_relay']['port']}"
                     if srv.get("udp_relay") else "")
                  + f" slot {sim['slot_base']}")
            for u in sim["units"]:
                fc = u["fc"]
                print(f"  {u['name']:12s} block={u['block']:16s} "
                      + (f"{fc['vehicle']} sysid={fc['sysid']} pilot={fc['pilot_port']} "
                         f"fcb={fc['fcb_port']} "
                         + (f"fcbpx={fc['fcb_proxy']['port']}/"
                            f"{fc['fcb_proxy']['ctrl']} "
                            if fc.get("fcb_proxy") else "") if fc else "no-fc ")
                      + " ".join(f"{m}:{p}" for m, p in u["ports"].items())
                      + (f" acc={u['account']['user']}" if u.get("account") else "")
                      + f"  @{u['position']['lat']:.6f},{u['position']['lng']:.6f}")
        elif c == "up":
            import launcher
            files = [x for x in a if not x.startswith("-")]
            bad = _bad_flags(a, ("--fresh", "--open-web"))
            if bad or len(files) != 1:
                sys.exit("usage: ./sim up <sim.yaml> [--fresh] "
                         "[--open-web]"
                         + (f" - unknown {' '.join(bad)}" if bad else ""))
            launcher.up(files[0], fresh="--fresh" in a,
                        open_web="--open-web" in a)
        elif c == "down":
            import launcher
            names = [x for x in a if not x.startswith("-")]
            bad = _bad_flags(a, ("--all",))
            if bad:
                sys.exit("usage: ./sim down [name|--all]"
                         + f" - unknown {' '.join(bad)}")
            launcher.down(None if not names or "--all" in a else names[0])
        elif c == "sims":
            json_out = "--json" in a
            bad = _bad_flags(a, ("--json",))
            if bad:
                sys.exit("usage: ./sim sims [--json]"
                         + f" - unknown {' '.join(bad)}")
            names = simlib.sim_names()
            if json_out:
                print(json.dumps({"sims": [
                    {"name": n,
                     "units": len(simlib.load_manifest(n)["units"]),
                     "server_type":
                         simlib.load_manifest(n)["server"]["type"],
                     "procs_alive": len(simlib.read_pids(n))}
                    for n in names]}, indent=1))
            elif not names:
                print("no sim generated - ./sim up <sim.yaml>")
            else:
                for n in names:
                    m = simlib.load_manifest(n)
                    srv = m["server"]
                    print(f"{n:16s} {len(m['units'])} unit(s)  "
                          f"server {srv['type']}  "
                          f"{len(simlib.read_pids(n))} proc(s) alive")
        elif c == "ports":
            # SL-0088: which of a sim's declared ports are actually bound
            # right now. `sim down` frees them all - this is the lease
            # visibility the udp_relay checks ask for.
            names = [x for x in a if not x.startswith("-")]
            bad = _bad_flags(a, ("--all",))
            if bad or len(names) > 1:
                sys.exit("usage: ./sim ports [name|--all]"
                         + f" - unknown {' '.join(bad)}")
            scope = names or [n for n in simlib.sim_names()
                              if "--all" in a or simlib.read_pids(n)]
            if not scope:
                print("no live sim - ./sim up <sim.yaml> "
                      "or ./sim ports --all")
            for sn in scope:
                try:
                    m = simlib.load_manifest(sn)
                except Exception as e:
                    sys.exit(f"sim {sn!r}: {e}")
                alive = len(simlib.read_pids(sn))
                # collapse the relay's per-port udp rows into one range row
                rng = [r for r in simlib.port_rows(m)
                       if r[0] == f"{simlib.UDP_RELAY_LEASE}.range"]
                rows = [r for r in simlib.port_rows(m)
                        if r[0] != f"{simlib.UDP_RELAY_LEASE}.range"]
                n_bound = sum(simlib.port_bound(p, "udp")
                              for _, p, _ in rng)
                print(f"{sn} ({alive} proc(s) alive)")
                w = max(len(r[0]) for r in rows) if rows else 0
                for owner, port, proto in rows:
                    state = "bound" if simlib.port_bound(port, proto) \
                        else "free"
                    print(f"  {owner:{w}s}  {port:>6}  {proto:3s} {state}")
                if rng:
                    lo, hi = rng[0][1], rng[-1][1]
                    print(f"  {simlib.UDP_RELAY_LEASE + '.range':{w}s}  "
                          f"{lo}-{hi}  udp {n_bound}/{len(rng)} bound")
        elif c == "status":
            import ctl
            import launcher
            # SL-0066 - surface orphaned scenario runners: a runner pid
            # alive while its fleet is down can still fire teardown
            # (op_abort/land) into whatever runs next; `sim down` reaps it
            for o in launcher.orphaned_runners():
                print(simlib.col_yellow(
                    f"orphaned scenario_runner pid {o['pid']} "
                    f"(sim {o['sim']!r}"
                    + (f", scenario {o['scenario']}" if o.get("scenario")
                       else "")
                    + f") - `./sim down {o['sim']}` reaps it"),
                    flush=True)
            # ctl parses `-s <sim>` only ahead of the command word -
            # hoist it so `./sim status -s X` works
            if len(a) >= 2 and a[0] in ("-s", "--sim"):
                ctl.main(a[:2] + ["status"] + a[2:])
            else:
                ctl.main(["status"] + a)
        elif c == "ctl":
            import ctl
            try:
                ctl.main(a)
            except KeyboardInterrupt:
                return 130
        elif c in ("run", "try"):
            import scenario_runner
            a, mods = _module_overrides(a)
            seed = 1
            if "--seed" in a:
                i = a.index("--seed")
                if i + 1 >= len(a):
                    sys.exit("--seed needs a value")
                seed = int(a[i + 1])
                del a[i:i + 2]
            record = None
            if "--record" in a:
                i = a.index("--record")
                if i + 1 >= len(a):
                    sys.exit("--record needs an output file")
                record = a[i + 1]
                del a[i:i + 2]
            files = [x for x in a if not x.startswith("-")]
            bad = _bad_flags(a, ("--keep", "--hold", "--view",
                                 "--open-web"))
            if bad or len(files) != 1:
                sys.exit(f"usage: ./sim {c} <file.yaml> [--seed N] "
                         "[--keep] [--hold|--view] [--record <file>] "
                         "[--open-web] [--module <name>=<path>] ..."
                         + (f" - unknown {' '.join(bad)}" if bad else ""))
            # `try` is the iteration form of `run`: it always keeps the
            # sim (no teardown) so the next try lands on a warm fleet
            keep = "--keep" in a or c == "try"
            # the override is installed before the sim resolves so it
            # feeds the hash (same fleet + different bins = swap, not
            # a silent reuse)
            simlib.set_module_overrides(mods)
            # every test/scenario file is de.scenario/1 -> the P5-07 engine
            return scenario_runner.run(files[0], keep=keep,
                                       hold=bool({"--hold", "--view"}
                                                 & set(a)), seed=seed,
                                       record=record,
                                       open_web="--open-web" in a)
        elif c == "suite":
            # the full suite driver (verdicts, flaky rerun, junit) lives
            # in ci/run_suite.py - forward everything after `--seeds`
            seeds = "1,2,3"
            if "--seeds" in a:
                i = a.index("--seeds")
                if i + 1 >= len(a):
                    sys.exit("--seeds needs a value")
                seeds = a[i + 1]
                del a[i:i + 2]
            tier = None
            if "--tier" in a:
                i = a.index("--tier")
                if i + 1 >= len(a):
                    sys.exit("--tier needs a value")
                tier = a[i + 1]
                del a[i:i + 2]
            keep = "--keep" in a
            dirs = [x for x in a if not x.startswith("-")] or ["tests"]
            bad = _bad_flags(a, ("--keep",))
            if bad:
                sys.exit("usage: ./sim suite [dir ...] [--seeds 1,2,3] "
                         "[--keep] [--tier smoke|regression]"
                         + f" - unknown {' '.join(bad)}")
            cmd = [sys.executable,
                   os.path.join(simlib.SIM_ROOT, "ci", "run_suite.py"),
                   "--roots"] + dirs + ["--seeds", seeds] \
                  + (["--keep"] if keep else []) \
                  + (["--tier", tier] if tier else [])
            return subprocess.call(cmd, cwd=simlib.SIM_ROOT)
        elif c == "list":
            json_out = "--json" in a
            roots = [x for x in a if not x.startswith("-")]
            bad = _bad_flags(a, ("--json",))
            if bad or any(r not in ("scenarios", "tests", "sims")
                          for r in roots):
                sys.exit("usage: ./sim list [--json] "
                         "[scenarios|tests|sims] ..."
                         + (f" - unknown {' '.join(bad)}" if bad else ""))
            if json_out:
                print(json.dumps({"roots": [
                    {"root": root,
                     "files": [
                         {"file": os.path.relpath(f, simlib.SIM_ROOT),
                          "description": _one_liner(f)[:80]}
                         for f in sorted(glob.glob(
                             os.path.join(simlib.SIM_ROOT, root,
                                          "**", "*.yaml"),
                             recursive=True))]}
                    for root in roots or ["scenarios", "tests"]]},
                                 indent=1))
            else:
                for root in roots or ["scenarios", "tests"]:
                    d = os.path.join(simlib.SIM_ROOT, root)
                    files = sorted(glob.glob(
                        os.path.join(d, "**", "*.yaml"), recursive=True))
                    print(f"{root}/  ({len(files)} files)")
                    for f in files:
                        rel = os.path.relpath(f, simlib.SIM_ROOT)
                        one = _one_liner(f)
                        print(f"  {rel:52s} {one[:80]}")
        elif c == "new":
            sensor = "--sensor" in a
            names = [x for x in a if not x.startswith("-")]
            bad = _bad_flags(a, ("--sensor",))
            ok_name = len(names) == 1 and \
                re.fullmatch(r"[\w-]+(/[\w-]+)*", names[0])
            if bad or not ok_name:
                sys.exit("usage: ./sim new <name> [--sensor] - word chars"
                         " (a/b nests under scenarios/; --sensor also"
                         " scaffolds blocks/<name>/ a world-driven"
                         " sensor stub)"
                         + (f" - unknown {' '.join(bad)}" if bad else ""))
            if sensor and "/" in names[0]:
                sys.exit("--sensor names a new block dir - no '/'")
            dst = os.path.join(simlib.SIM_ROOT, "scenarios",
                               names[0] + ".yaml")
            if os.path.exists(dst):
                sys.exit(f"{dst} already exists")
            if sensor:
                _scaffold_sensor(names[0])
            tpl = open(os.path.join(simlib.SIM_ROOT, "templates",
                                    "scenario_sensor.yaml" if sensor
                                    else "scenario.yaml")).read()
            # @REL@ = repo-root prefix for the file's depth under
            # scenarios/ (scenarios/x.yaml -> ../, scenarios/a/b.yaml
            # -> ../../)
            depth = names[0].count("/") + 1
            tpl = tpl.replace("@NAME@",
                              os.path.basename(names[0])) \
                     .replace("@REL@", "../" * depth)
            os.makedirs(os.path.dirname(dst), exist_ok=True)
            open(dst, "w").write(tpl)
            rel = os.path.relpath(dst, simlib.SIM_ROOT)
            print(f"wrote {rel} - edit the header + fleet/timeline, then:")
            print(f"  ./sim validate {rel} && ./sim run {rel}")
        elif c == "validate":
            json_out = "--json" in a
            files = [x for x in a if not x.startswith("-")]
            bad = _bad_flags(a, ("--json",))
            if bad or len(files) != 1:
                sys.exit("usage: ./sim validate <file.yaml> [--json]"
                         + (f" - unknown {' '.join(bad)}" if bad else ""))
            problems = _validate_file(files[0])
            if json_out:
                print(json.dumps({"file": files[0],
                                  "ok": not problems,
                                  "problems": problems}, indent=1))
                sys.exit(0 if not problems else 1)
            if problems:
                for p in problems:
                    print(simlib.col_red("not ok") + f"  {p}")
                sys.exit(f"{files[0]}: {len(problems)} problem(s)")
            print(simlib.col_green("ok") + f"  {files[0]}")
        elif c == "expand":
            import scenario as scenario_mod
            seed = None
            if "--seed" in a:
                i = a.index("--seed")
                if i + 1 >= len(a):
                    sys.exit("--seed needs a value")
                seed = int(a[i + 1])
                del a[i:i + 2]
            files = [x for x in a if not x.startswith("-")]
            bad = _bad_flags(a, ("--json",))
            if bad or len(files) != 1:
                sys.exit("usage: ./sim expand <file.yaml> [--seed N] "
                         "[--json]"
                         + (f" - unknown {' '.join(bad)}" if bad else ""))
            scn = scenario_mod.load_scenario(files[0], seed=seed,
                                             probe_ports=False)
            if not scn.get("expanded"):
                if "--json" in a:
                    print(json.dumps({"file": files[0],
                                      "name": scn["name"],
                                      "seed": scn["seed"],
                                      "expanded": None,
                                      "error": "no chaos: block to "
                                               "expand"}, indent=1))
                    return 1
                sys.exit(f"{files[0]}: no chaos: block to expand")
            if "--json" in a:
                print(json.dumps(
                    {"file": files[0], "name": scn["name"],
                     "seed": scn["seed"],
                     "expanded": scenario_mod.expanded_spec(scn)},
                    indent=1))
            else:
                sys.stdout.write(scenario_mod.expanded_text(scn))
        elif c == "record":
            import record as record_mod
            record_mod.main(a)
        elif c == "studio":
            import launcher
            world = record = None
            rest = []
            i = 0
            while i < len(a):
                if a[i] == "--world":
                    if i + 1 >= len(a):
                        sys.exit("--world needs a file or worlds/ name")
                    world = a[i + 1]
                    i += 2
                elif a[i] == "--record":
                    if i + 1 >= len(a):
                        sys.exit("--record needs an output file")
                    record = a[i + 1]
                    i += 2
                else:
                    rest.append(a[i])
                    i += 1
            files = [x for x in rest if not x.startswith("-")]
            bad = _bad_flags(rest, ("--down",))
            if bad or len(files) != 1:
                sys.exit("usage: ./sim studio <sim.yaml> [--world <w>] "
                         "[--record <file>] [--down]"
                         + (f" - unknown {' '.join(bad)}" if bad else ""))
            launcher.studio(files[0], world=world, record_out=record,
                            teardown="--down" in rest)
        elif c == "view":
            import scenario_runner
            record = None
            if "--record" in a:
                i = a.index("--record")
                if i + 1 >= len(a):
                    sys.exit("--record needs an output file")
                record = a[i + 1]
                del a[i:i + 2]
            files = [x for x in a if not x.startswith("-")]
            bad = _bad_flags(a, ("--open-web",))
            if bad or len(files) != 1:
                sys.exit("usage: ./sim view <scenario.yaml> "
                         "[--record <file>] [--open-web]"
                         + (f" - unknown {' '.join(bad)}" if bad else ""))
            return scenario_runner.run(files[0], hold=True,
                                       record=record,
                                       open_web="--open-web" in a)
        elif c == "logs":
            sim_name = None
            if a and a[0] in ("-s", "--sim"):
                sim_name, a = a[1], a[2:]
            owner = a[0]
            if owner == "server":
                d = os.path.join(
                    simlib.server_dir(sim_name or simlib._single_sim()),
                    "logs")
            else:
                u = simlib.find_unit(owner, sim_name)
                if not u:
                    sys.exit(f"unknown unit {owner!r} (no generated sim "
                             "has it)")
                d = os.path.join(simlib.unit_dir(u), "logs")
            proc = a[1] if len(a) > 1 else None
            files = [os.path.join(d, f) for f in sorted(os.listdir(d))
                     if proc is None or f == proc + ".log"]
            subprocess.call(["tail", "-n", "40"] + files)
        elif c == "doctor":
            import doctor
            return doctor.main(a)
        elif c == "esp32":
            import esp32
            return esp32.main(a)
        elif c == "verbs":
            import registry
            bad = _bad_flags(a, ("--json",))
            if bad:
                sys.exit("usage: ./sim verbs [--json]"
                         + (f" - unknown {' '.join(bad)}" if bad else ""))
            if "--json" in a:
                print(json.dumps({"verbs": [
                    {"name": v["name"], "kind": v["kind"],
                     "args": {"required": v["req"],
                              "optional": v["opt"]},
                     "doc": v["doc"], "example": v["eg"]}
                    for v in registry.VERBS]}, indent=1))
            else:
                w = max(len(v["name"]) for v in registry.VERBS)
                groups = (("step", "do: steps (act on the fleet)"),
                          ("probe", "do: probes (observe only)"),
                          ("fault", "fault: kinds"),
                          ("check", "assert: checks"))
                for kind, title in groups:
                    print(title)
                    for v in registry.by_kind(kind):
                        args = ", ".join(
                            [f"<{a}>" for a in v["req"]] +
                            [f"[{a}]" for a in v["opt"]])
                        print(f"  {v['name']:{w}}  {v['doc']}")
                        if args:
                            print(f"  {'':{w}}  args: {args}")
                        if v["eg"]:
                            print(f"  {'':{w}}  eg:   {v['eg']}")
                    print()
        elif c == "clean":
            import clean
            return clean.main(a)
        else:
            _print_usage()
            return 1
    except simlib.SimError as e:
        sys.exit(simlib.col_red("error:") + f" {e}")
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))

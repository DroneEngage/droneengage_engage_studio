{
    "fileType": "de_operation",
    "schema": "de.operation/2",
    "op": "pl_copter_dropout",
    "comment": "PL-09 group B: the land_nav closed loop plus a sensor mission `watch` triggered by the precision_landing.lost fact. The pad world occludes the tag mid-descent; the stub drops lock, lost fires, watch emits pad.alarm, and the FC re-acquires when the window ends.",
    "roles": {
        "lander": {
            "count": 1,
            "vehicle": "copter",
            "requires": [
                "precision_landing"
            ]
        }
    },
    "events": {
        "precision_landing.stabilized": {
            "persist": "run",
            "payload": {
                "held_s": "number",
                "range_m": "number",
                "rmse_px": "number",
                "target": "number"
            }
        },
        "precision_landing.lost": {
            "persist": "run",
            "payload": {
                "held_s": "number",
                "reason": "string"
            }
        },
        "pad.alarm": {}
    },
    "missions": {
        "lander": {
            "main": {
                "trigger": "op.start",
                "end": "hold",
                "steps": [
                    {
                        "id": "takeoff",
                        "nav": "takeoff",
                        "alt": 15
                    },
                    {
                        "id": "over",
                        "nav": "wp",
                        "pos": [
                            -35.363262,
                            149.165237,
                            20
                        ],
                        "actions": [
                            {
                                "on": "start",
                                "do": "precision_landing.enable"
                            }
                        ]
                    },
                    {
                        "id": "pl",
                        "gate": {
                            "event": "precision_landing.stabilized"
                        },
                        "timeout": 30,
                        "on_timeout": "continue",
                        "pos": [
                            -35.363262,
                            149.165237,
                            20
                        ]
                    },
                    {
                        "id": "down",
                        "nav": "land",
                        "pos": [
                            -35.363262,
                            149.165237
                        ]
                    }
                ]
            },
            "watch": {
                "trigger": {
                    "event": "precision_landing.lost",
                    "once_per": "run"
                },
                "end": "hold",
                "steps": [
                    {
                        "id": "a1",
                        "emit": "pad.alarm"
                    }
                ]
            }
        }
    }
}

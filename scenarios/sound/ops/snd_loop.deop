{
    "fileType": "de_operation",
    "schema": "de.operation/2",
    "op": "snd_loop",
    "comment": "TASK-EV-SND sound_loop_stop (D-SND-3): a {loop:true} siren runs until a sound.siren.stop command ends it (finished reason 'stopped'), then a second loop is left running and the module's loop_max_s cap (5 s in the sim) ends it (reason 'limit'). g_limit uses the all_of cond form: the simple {event} gate reads the run-long latch - finished is already latched by the 'stopped' fact - while a cond term counts only evidence received at/after the gate's entry.",

    "roles": {
        "rig": { "count": 1, "vehicle": "static", "requires": ["sound"] }
    },

    "events": {
        "sound.siren.play":     { "payload": { "loop": "boolean" } },
        "sound.siren.stop":     {},
        "sound.siren.started":  {},
        "sound.siren.finished": {},
        "sound.probe_done":     {}
    },

    "missions": {
        "rig": {
            "walk": {
                "trigger": "op.start",
                "end": "hold",
                "steps": [
                    { "id": "e_loop", "emit": "sound.siren.play",
                      "payload": { "loop": true } },
                    { "id": "g_start", "gate": { "event": "sound.siren.started" },
                      "timeout": 15, "on_timeout": "end" },
                    { "id": "e_stop", "emit": "sound.siren.stop" },
                    { "id": "g_stop", "gate": { "event": "sound.siren.finished" },
                      "timeout": 15, "on_timeout": "end" },
                    { "id": "e_loop2", "emit": "sound.siren.play",
                      "payload": { "loop": true } },
                    { "id": "g_limit",
                      "gate": { "all_of": [ { "event": "sound.siren.finished" } ] },
                      "timeout": 30, "on_timeout": "end" },
                    { "id": "e_done", "emit": "sound.probe_done" }
                ]
            }
        }
    }
}

{
  "schema": "de.package/2.2",
  "op": "gpio_guard",
  "op_hash": "sha256:b1eb10a3c68716c0af10a2fc7cdc22f7944bcc5f11ab070e144751d10008a2e1",
  "role": "node",
  "vehicle": {
    "type": "static"
  },
  "requires": [
    "gpio"
  ],
  "fc_items": [],
  "missions": {
    "guard": {
      "trigger": {
        "type": "op.start"
      },
      "priority": 0,
      "sensor": true,
      "end_state": "hold",
      "claims": [
        "gpio"
      ],
      "on_exit": [],
      "steps": [
        {
          "id": "e1",
          "k": "emit",
          "event": "gpio.drop.pulse"
        },
        {
          "id": "d1",
          "k": "do",
          "do": "gpio.drop",
          "with": {
            "on": true
          },
          "timeout": 10,
          "on_error": "continue"
        },
        {
          "id": "g1",
          "k": "gate",
          "event": "gpio.drop.went_on",
          "timeout": 8,
          "on_timeout": "continue"
        },
        {
          "id": "e2",
          "k": "emit",
          "event": "gpio.guard_done"
        }
      ]
    }
  },
  "manifest": [],
  "events": {
    "gpio.drop.pulse": {},
    "gpio.drop.went_on": {},
    "gpio.guard_done": {}
  },
  "handlers": {},
  "fleet": {
    "roles": {
      "node": {
        "count": 1
      }
    },
    "phases": [],
    "event_ttl": {
      "gpio.drop.pulse": 300,
      "gpio.drop.went_on": 300,
      "gpio.guard_done": 300
    }
  },
  "hash": "sha256:de2012b7ab10ee0fd6d1c13f251453f8db95aeed877b2963d6fc6621a911756b"
}

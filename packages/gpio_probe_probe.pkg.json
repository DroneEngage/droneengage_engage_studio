{
  "schema": "de.package/2.2",
  "op": "gpio_probe",
  "op_hash": "sha256:f4480dd253f6939261e26474ccbe47c92213d639e25e68ce00d2b9de0a0d91d1",
  "role": "probe",
  "vehicle": {
    "type": "static"
  },
  "requires": [
    "gpio"
  ],
  "fc_items": [],
  "missions": {
    "walk": {
      "trigger": {
        "type": "op.start"
      },
      "priority": 0,
      "sensor": true,
      "end_state": "hold",
      "claims": [],
      "on_exit": [],
      "steps": [
        {
          "id": "e1",
          "k": "emit",
          "event": "gpio.led.on"
        },
        {
          "id": "g1",
          "k": "gate",
          "event": "gpio.led.went_on",
          "timeout": 10,
          "on_timeout": "end"
        },
        {
          "id": "e2",
          "k": "emit",
          "event": "gpio.flash.pulse",
          "payload": {
            "ms": 300
          }
        },
        {
          "id": "g2",
          "k": "gate",
          "event": "gpio.flash.went_off",
          "timeout": 5,
          "on_timeout": "end"
        },
        {
          "id": "e3",
          "k": "emit",
          "event": "gpio.ghost.on"
        },
        {
          "id": "g3",
          "k": "gate",
          "event": "gpio.ghost.went_on",
          "timeout": 5,
          "on_timeout": "continue"
        },
        {
          "id": "e4",
          "k": "emit",
          "event": "gpio.probe_done"
        }
      ]
    }
  },
  "manifest": [],
  "events": {
    "gpio.led.on": {},
    "gpio.led.went_on": {},
    "gpio.flash.pulse": {
      "payload": {
        "ms": "number"
      }
    },
    "gpio.flash.went_off": {},
    "gpio.ghost.on": {},
    "gpio.ghost.went_on": {},
    "gpio.probe_done": {}
  },
  "handlers": {},
  "fleet": {
    "roles": {
      "probe": {
        "count": 1
      }
    },
    "phases": [],
    "event_ttl": {
      "gpio.led.on": 300,
      "gpio.led.went_on": 300,
      "gpio.flash.pulse": 300,
      "gpio.flash.went_off": 300,
      "gpio.ghost.on": 300,
      "gpio.ghost.went_on": 300,
      "gpio.probe_done": 300
    }
  },
  "hash": "sha256:cf009facd8e826a09a3e9664e6b7e00d12e88677b51606e0c66a8cae9b937075"
}

{
  "fileType": "de_operation",
  "schema": "de.operation/2",
  "op": "perception_thermal",
  "comment": "SL-0035 (b) acceptance op: a static mast running stub_ai_box camera_kind:thermal projects obs whose wire cls is the de_ir_camera vocabulary; detect.detected is declared a 'hotspot' target event, so hotspot detections fuse into world-model targets while coldspot detections latch but never book a target. No op end: the scenario stops the run. Compiles to de.package/2.6.",
  "area": [[-35.36295, 149.16555], [-35.36355, 149.16555],
           [-35.36355, 149.16490], [-35.36295, 149.16490]],
  "roles": {
    "watcher": {"count": 1, "vehicle": "static",
                "requires": ["camera"]}
  },
  "events": {
    "detect.detected": {"target": "hotspot",
      "payload": {"tid": "string", "pos": "geo", "unc_m": "number",
                  "conf": "number", "class": "string",
                  "cam_id": "string", "trk": "number"}},
    "watch.done": {}
  },
  "missions": {
    "watcher": {
      "watch": {
        "trigger": "op.start",
        "steps": [
          {"id": "seen", "gate": {"event": "detect.detected"},
           "timeout": 240, "on_timeout": "end"},
          {"id": "dwell", "gate": {"time_at": {"after_start_s": 10}},
           "timeout": 300, "on_timeout": "continue"},
          {"id": "note", "emit": "watch.done",
           "payload_from": "seen"}
        ],
        "end": "hold"
      }
    }
  }
}

{
    "fileType": "de_operation",
    "schema": "de.operation/2",
    "op": "camera_probe",
    "comment": "TASK-EV-CAM emit_and_notify: a sensor mission emits camera.<ch> command events (cam_0.record_on, cam_0.record_off, ghost.record_on); the namespace owner (de_camera) drives the recorder and its camera.<ch>.went_* notifications come back as events, releasing the mission's gates. g1/g2 must release; g3 (nonexistent channel) must time out on continue - the emit alone never releases a notification gate.",

    "roles": {
        "probe": { "count": 1, "vehicle": "copter", "requires": ["camera"] }
    },

    "events": {
        "camera.cam_0.record_on":       {},
        "camera.cam_0.record_off":      {},
        "camera.cam_0.went_recording":  {},
        "camera.cam_0.went_idle":       {},
        "camera.ghost.record_on":       {},
        "camera.ghost.went_recording":  {},
        "camera.probe_done":            {}
    },

    "missions": {
        "probe": {
            "walk": {
                "trigger": "op.start",
                "end": "hold",
                "steps": [
                    { "id": "e1", "emit": "camera.cam_0.record_on" },
                    { "id": "g1", "gate": { "event": "camera.cam_0.went_recording" },
                      "timeout": 15, "on_timeout": "end" },
                    { "id": "e2", "emit": "camera.cam_0.record_off" },
                    { "id": "g2", "gate": { "event": "camera.cam_0.went_idle" },
                      "timeout": 20, "on_timeout": "end" },
                    { "id": "e3", "emit": "camera.ghost.record_on" },
                    { "id": "g3", "gate": { "event": "camera.ghost.went_recording" },
                      "timeout": 5, "on_timeout": "continue" },
                    { "id": "e4", "emit": "camera.probe_done" }
                ]
            }
        }
    }
}

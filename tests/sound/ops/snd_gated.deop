{
    "fileType": "de_operation",
    "schema": "de.operation/2",
    "op": "snd_gated",
    "comment": "TASK-EV-SND sound_gated: the 'Horn' clip is configured events:false - its sound.horn.play command is delivered but ignored (no playback, no facts), so g_horn times out on continue. The per-clip `do` action is NOT gated by events:false - d_horn plays the clip (invoke result ok) yet still emits no sound.horn.* facts.",

    "roles": {
        "rig": { "count": 1, "vehicle": "static", "requires": ["sound"] }
    },

    "events": {
        "sound.horn.play":      {},
        "sound.horn.started":   {},
        "sound.horn.finished":  {},
        "sound.probe_done":     {}
    },

    "missions": {
        "rig": {
            "walk": {
                "trigger": "op.start",
                "end": "hold",
                "steps": [
                    { "id": "e_horn", "emit": "sound.horn.play" },
                    { "id": "g_horn", "gate": { "event": "sound.horn.finished" },
                      "timeout": 10, "on_timeout": "continue" },
                    { "id": "d_horn", "do": "sound.horn", "timeout": 10 },
                    { "id": "e_done", "emit": "sound.probe_done" }
                ]
            }
        }
    }
}

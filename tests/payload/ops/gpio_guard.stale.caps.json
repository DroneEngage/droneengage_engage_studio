            }
          },
          "btn_low.changed": {
            "payload": {
              "v": {
                "type": "int"
              },
              "src": {
                "type": "string"
              }
            }
          },
          "power_led.went_on": {
            "payload": {
              "v": {
                "type": "int"
              },
              "src": {
                "type": "string"
              }
            }
          },
          "power_led.went_off": {
            "payload": {
              "v": {
                "type": "int"
              },
              "src": {
                "type": "string"
              }
            }
          },
          "power_led.changed": {
            "payload": {
              "v": {
                "type": "int"
              },
              "src": {
                "type": "string"
              }
            }
          },
          "drop.went_on": {

              }
            }
          }
        },
        "state": {
          "led": {
            "type": "int",
            "desc": "GPIO 4 level"
          },
          "power_led": {
            "type": "int",
            "desc": "GPIO 2 level"
          },
          "flash": {
            "type": "int",
            "desc": "GPIO 5 level"
          },
          "servo": {
            "type": "int",
            "desc": "GPIO 18 PWM width"
          },
          "btn": {

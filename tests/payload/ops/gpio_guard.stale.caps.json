                "type": "int"
              },
              "src": {
                "type": "string"
              }
            }
          },
          "btn.changed": {
            "payload": {
              "v": {
                "type": "int"
              },
              "src": {
                "type": "string"
              }
            }
          },
          "btn_low.went_on": {
            "payload": {
              "v": {
                "type": "int"
              },

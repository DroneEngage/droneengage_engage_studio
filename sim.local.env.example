# Per-machine paths for droneengage_simulation_land.
#   cp sim.local.env.example sim.local.env    (sim.local.env is gitignored)
# Every key is optional; an environment variable with the same name wins.
# ~ and $KEY (keys set above, or env vars) are expanded.

# Root of the DroneEngage checkouts. Each repo defaults to $DE_CODE/<repo>.
DE_CODE=~/de_code

# Override single repos when they live elsewhere:
#DE_COMM_DIR=$DE_CODE/droneengage_communication
#DE_MAVLINK_DIR=$DE_CODE/droneengage_mavlink
#DE_CAMERA_DIR=$DE_CODE/droneengage_camera
#DE_TRACKER_DIR=$DE_CODE/droneengage_visual_tracker
#DE_SERVER_DIR=$DE_CODE/droneengage_server
#DE_AUTH_DIR=$DE_CODE/droneengage_authenticator

# Binaries built outside their repo (e.g. de_camera in the WebRTC tree):
#DE_COMM_BIN=$DE_COMM_DIR/bin/de_comm
#DE_CAMERA_BIN=~/webrtc/src/out/x64/de_camera

# ArduPilot checkout with SITL built (./waf configure --board sitl && ./waf copter plane rover)
ARDUPILOT_DIR=~/code/ardupilot

# node used for droneengage_server / droneengage_authenticator (e.g. an nvm node)
#NODE=~/.nvm/versions/node/v20.11.0/bin/node

# Account used by sims with `server: {type: external}` (your own server
# stack) when the sim yaml has no `server.account`. The account must exist
# on your authenticator - account_storage_type single => its
# single_account_* values; db => create it in the webadmin.
#SIM_AUTH_USER=sim@sim.droneengage.com
#SIM_AUTH_CODE=sim1234

# Where generated configs / logs / journals and test results go
#SIM_RUN_DIR=./run
#SIM_RESULTS_DIR=./results

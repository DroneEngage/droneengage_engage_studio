# Per-machine paths for droneengage_simulation_land.
#   cp sim.local.env.example sim.local.env    (sim.local.env is gitignored)
# Every key is optional; an environment variable with the same name wins.
# ~ and $KEY (keys set above, or env vars) are expanded.

# Root of the DroneEngage checkouts. Each repo defaults to $DE_CODE/<repo>.
DE_CODE=~/de_code

# Override single repos when they live elsewhere:
#DE_COMM_DIR=$DE_CODE/droneengage_communication
#DE_MAVLINK_DIR=$DE_CODE/droneengage_mavlink
#DE_CAMERA_DIR=$DE_CODE/droneengage_camera
#DE_TRACKER_DIR=$DE_CODE/droneengage_visual_tracker
#DE_GPIO_DIR=$DE_CODE/droneengage_rpi_gpio
#DE_SERVER_DIR=$DE_CODE/droneengage_server
#DE_AUTH_DIR=$DE_CODE/droneengage_authenticator

# Binaries built outside their repo (e.g. de_camera in the WebRTC tree):
#DE_COMM_BIN=$DE_COMM_DIR/bin/de_comm
#DE_CAMERA_BIN=~/webrtc/src/out/x64/de_camera
# de_rpi_gpio needs a test-mode build for the sim
# (cmake -DTEST_MODE_NO_WIRINGPI_LINK=ON, or ./build_ddebug.sh):
#DE_GPIO_BIN=$DE_CODE/droneengage_rpi_gpio/bin/de_rpi_gpio

# ArduPilot checkout with SITL built (./waf configure --board sitl && ./waf copter plane rover)
ARDUPILOT_DIR=~/code/ardupilot

# Mavlink3DMap checkout for `render:` sims with mode viewer|full
# (launches backend/src/udp2websocket.js + a vite dev server)
#MAVLINK3DMAP_DIR=~/code/Mavlink3DMap

# P5-15 rendered cameras (render.mode cameras|full): the headless
# Chromium that draws each copter_cam3d unit's world camera, and the
# ffmpeg the render sink pipes frames through into v4l2loopback
#CHROMIUM_BIN=google-chrome
#FFMPEG=ffmpeg
# v4l2loopback card labels per camera unit (comma lists, indexed by
# cam_index). Default DE-SRC-k / DE-AI-k - created once by
# `sudo tools/setup_v4l2loopback.sh N`. To reuse an existing named-VC
# setup (e.g. the camera repo's sh_camera_create_named_vc.sh):
#SIM_V4L2_SRC_LABELS=SIM-CAM1
#SIM_V4L2_AI_LABELS=DE-AI

# node used for droneengage_server / droneengage_authenticator (e.g. an nvm node)
#NODE=~/.nvm/versions/node/v20.11.0/bin/node

# Accounts used by sims with `server: {type: external}` (your own server
# stack) when the sim yaml has no `server.account` / `server.unit_account`.
# All must exist on your authenticator under the SAME team or the GCS
# won't see the units. account_storage_type single => its single_account_*
# values for both; db => create logins in the webadmin.
#SIM_AUTH_USER=sim@sim.droneengage.com   # GCS login (needs the GCS bit)
#SIM_AUTH_CODE=sim1234
#SIM_UNIT_AUTH_USER=sim@sim.droneengage.com   # default unit login (unit bit)
#SIM_UNIT_AUTH_CODE=sim1234

# Where generated configs / logs / journals and test results go
#SIM_RUN_DIR=./run
#SIM_RESULTS_DIR=./results
